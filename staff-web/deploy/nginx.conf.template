worker_processes 1;
pid /tmp/nginx.pid;
error_log stderr warn;

events {
    worker_connections 512;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    sendfile on;

    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;

    # Access logs are provided by Cloud Run. Avoid logging query strings twice.
    access_log off;

    map $uri $static_cache_control {
        ~^/assets/ "public, max-age=31536000, immutable";
        default    "no-cache";
    }

    server {
        listen ${PORT};
        root /srv/staff-web;
        absolute_redirect off;
        client_max_body_size 2m;

        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; connect-src 'self'; img-src 'self'; font-src 'self'" always;

        location = /healthz {
            default_type text/plain;
            return 200 "ok\n";
        }

        location = /api {
            return 404;
        }

        location ^~ /api/ {
            proxy_pass https://${STAFF_API_HOST};
            proxy_http_version 1.1;
            proxy_ssl_server_name on;
            proxy_ssl_name ${STAFF_API_HOST};
            proxy_ssl_verify on;
            proxy_ssl_verify_depth 3;
            proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
            proxy_connect_timeout 5s;
            proxy_send_timeout 30s;
            proxy_read_timeout 45s;
            proxy_redirect https://${STAFF_API_HOST}/ /;
            proxy_redirect http://${STAFF_API_HOST}/ /;

            proxy_set_header Host ${STAFF_API_HOST};
            proxy_set_header Connection "";
            # Both public hops terminate HTTPS on Cloud Run. Never reuse client transport headers.
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-Port "";
            proxy_set_header X-Forwarded-For "";
            proxy_set_header Forwarded "";
            proxy_set_header X-Real-IP "";
            proxy_set_header X-Forwarded-Authorization "";
            proxy_set_header X-Serverless-Authorization "";
            proxy_set_header X-Forwarded-Client-Cert "";

            # Origin, Sec-Fetch-Site, Staff and correlation headers, Cookie and Set-Cookie
            # retain their original values. Backend authorization and CSRF checks still apply.
            proxy_intercept_errors off;
            proxy_buffering off;
        }

        location /assets/ {
            # Inherit security headers in addition to the cache policy (NGINX >= 1.29.3).
            add_header_inherit merge;
            add_header Cache-Control $static_cache_control;
            try_files $uri =404;
        }

        location / {
            add_header_inherit merge;
            add_header Cache-Control $static_cache_control;
            try_files $uri /index.html;
        }
    }
}
