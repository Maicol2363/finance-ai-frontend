# syntax=docker/dockerfile:1.7
FROM python:3.14.7-slim-bookworm@sha256:416f0db2a2b561945630cef9877a7ea0581b27449eb9fd9df42f03e1b74b5b63

ARG FLUTTER_VERSION=3.47.2
ARG FLUTTER_ARCHIVE_SHA256=447878859d01ca9bfdb99a85f245af07ed8a15fedcd9d189c4749e8e92d1f185

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        clang \
        cmake \
        curl \
        git \
        libgtk-3-dev \
        libglu1-mesa \
        libsecret-1-dev \
        ninja-build \
        pkg-config \
        unzip \
        xauth \
        xvfb \
        xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10002 flutter \
    && useradd --system --uid 10002 --gid flutter --create-home flutter \
    && mkdir -p /opt/flutter /workspace \
    && chown -R flutter:flutter /opt/flutter /workspace

ADD --checksum=sha256:${FLUTTER_ARCHIVE_SHA256} \
    https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz \
    /tmp/flutter.tar.xz

RUN tar --extract --xz --file=/tmp/flutter.tar.xz --directory=/opt \
    && rm /tmp/flutter.tar.xz \
    && chown -R flutter:flutter /opt/flutter

ENV PATH="/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:${PATH}"

USER flutter
WORKDIR /workspace

RUN git config --global --add safe.directory /opt/flutter \
    && flutter config --no-analytics \
    && flutter precache --linux

COPY --chown=flutter:flutter pubspec.yaml pubspec.lock ./
RUN flutter pub get --enforce-lockfile

COPY --chown=flutter:flutter . .

CMD ["flutter", "test", "integration_test/register_flow_test.dart"]
